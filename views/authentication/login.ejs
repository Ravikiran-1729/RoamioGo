<% layout('/layouts/boilerplate.ejs')-%>


<div class="row">
    <div class="
        col-12
        col-sm-10 offset-sm-1
        col-md-8 offset-md-2
        col-lg-6 offset-lg-3">
        <br>
        <h1>Login with RoamioGo - Solution for Luxary Stay</h1>
        <hr>
        <form method="post" action="/roamioGo/login" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label"><i class="fa-solid fa-wand-magic-sparkles"></i>
                    Username</label>
                <input name="username" type="text" class="form-control" id="username"
                    placeholder="@ravikiran-1729" required>
            </div>


            <div class="mb-3">
                <label for="password" class="form-label"><i class="fa-solid fa-key"></i>
                    password</label>
                <input name="password" type="password" class="form-control" id="password"
                    placeholder="Enter your password" required>
            </div>

            <br>
            <div class="login-btn-div">
                <button type="submit" class="btn login-btn mb-3"><i class="fa-solid fa-arrow-right-to-bracket"></i> Login</button>
            </div>
        </form>
    </div>
</div>