<%if(success && success.length){%>

    <div class="mt-3" style="padding: 0 1rem;">
        <div class="alert alert-success alert-dismissible fade show  border-0 col-12 
        col-sm-10 offset-sm-1
        col-md-8 offset-md-2
        col-lg-6 offset-lg-3" role="alert">
            <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
    <%}else if(error && error.length){%>

        <div class="mt-3" style="padding: 0 1rem;">
            <div class="alert alert-warning alert-dismissible border-0 fade show col-12
                col-sm-10 offset-sm-1
                col-md-8 offset-md-2
                col-lg-6 offset-lg-3" role="alert">
                <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
        <%}%>